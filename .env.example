# Local development values only. Never commit real secrets.
# Copy to .env (`cp .env.example .env`); .env is git-ignored.

NODE_ENV=development

# API
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
APP_ORIGIN=http://localhost:3000

# Database
# Runtime connection: application role (no UPDATE/DELETE/TRUNCATE on audit_logs).
DATABASE_URL=postgresql://legaltech_app:legaltech_app_dev@localhost:5432/legaltech?schema=public
# Migrations: owner role.
DATABASE_MIGRATION_URL=postgresql://legaltech_owner:legaltech_owner_dev@localhost:5432/legaltech?schema=public
