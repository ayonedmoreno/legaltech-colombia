# Local development values only. Never commit real secrets.
# Copy to .env (`cp .env.example .env`); .env is git-ignored.

# Required: development | test | production. The API refuses to start without it.
NODE_ENV=development

# API
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
APP_ORIGIN=http://localhost:3000
# Reverse proxies whose X-Forwarded-For the API trusts (comma-separated IPs or CIDRs).
# Keep empty: the Next.js /api/* rewrite does not set a trustworthy X-Forwarded-For, so
# trusting it would let clients pick their own IP. Set it only for an edge proxy (P3).
# Never list the web server's own address before that edge exists. /0 ranges and ::ffff:0:0/96
# (every IPv4 address) are rejected.
API_TRUST_PROXY=

# Web (read by the Next.js process, not by the API)
# Where the web server forwards /api/* (ADR-002). Defaults to http://127.0.0.1:4000.
# Fixed at `next build` time: deployments must build with their own value.
# API_INTERNAL_URL=http://127.0.0.1:4000

# Database
# Runtime connection: application role (no UPDATE/DELETE/TRUNCATE on audit_logs).
DATABASE_URL=postgresql://legaltech_app:legaltech_app_dev@localhost:5432/legaltech?schema=public
# Migrations: owner role.
DATABASE_MIGRATION_URL=postgresql://legaltech_owner:legaltech_owner_dev@localhost:5432/legaltech?schema=public

# Documents (Phase 3)
# Upload limit in bytes (10 MB, provisional technical value) and download URL lifetime.
# DOCUMENT_MAX_BYTES=10485760
# DOCUMENT_DOWNLOAD_URL_TTL_SECONDS=60

# Object storage (S3-compatible). Development: SeaweedFS from `pnpm db:up`; create the bucket
# once with `pnpm storage:init`. Production provider and region: decision P3.
STORAGE_BUCKET=legaltech-documents
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://127.0.0.1:8333
# Endpoint the browser downloads from (presigned URLs); defaults to STORAGE_ENDPOINT.
# STORAGE_PUBLIC_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=true
STORAGE_ACCESS_KEY_ID=legaltech_dev
STORAGE_SECRET_ACCESS_KEY=legaltech_dev_secret

# Worker (apps/worker, Phase 3): its own database role, only for the document treatment.
WORKER_DATABASE_URL=postgresql://legaltech_worker:legaltech_worker_dev@localhost:5432/legaltech?schema=public
# ClamAV (clamd) from `pnpm db:up`.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=60000
# Treatments per document before SCAN_FAILED, and how long a claim lasts before it is retaken.
# SCAN_MAX_ATTEMPTS=5
# SCAN_LEASE_SECONDS=600

# Development seed of internal accounts (`pnpm db:seed`, ADR-003). Choose your own value
# (12 to 128 characters); it is never committed or printed. Refused unless NODE_ENV is
# explicitly development or test.
# SEED_INTERNAL_PASSWORD=
