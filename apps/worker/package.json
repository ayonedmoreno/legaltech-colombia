{
  "name": "@legaltech/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background worker (ADR-001): pg-boss jobs such as the document antivirus scan",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run integration.test --no-file-parallelism",
    "ocr:activate": "tsx src/scripts/activate-ocr.ts"
  },
  "dependencies": {
    "@legaltech/contracts": "workspace:*",
    "@legaltech/database": "workspace:*",
    "@legaltech/storage": "workspace:*",
    "pg-boss": "12.35.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv-cli": "^7.4.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  }
}
