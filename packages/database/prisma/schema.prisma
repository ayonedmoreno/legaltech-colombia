// Identity slice, Case slices and the first Documents slice (DATABASE_SPEC.md). Other entities are added by approved
// slices.
// Migrations are versioned SQL in ./migrations; see README.md in this package.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime connection (application role).
  url       = env("DATABASE_URL")
  // Prisma CLI (migrate, diff) uses the owner role.
  directUrl = env("DATABASE_MIGRATION_URL")
}

enum Role {
  USER
  PROFESSIONAL
  ADMIN
  SUPER_ADMIN

  @@map("role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

enum SessionRevokedReason {
  LOGOUT
  LOGOUT_ALL
  PASSWORD_RESET
  PASSWORD_CHANGE
  ROTATED
  ROLE_CHANGE
  ADMIN_REVOKE
  EXPIRED

  @@map("session_revoked_reason")
}

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String     @unique
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  passwordHash    String     @map("password_hash")
  fullName        String     @map("full_name")
  role            Role       @default(USER)
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]
  emailOutbox             EmailOutbox[]
  cases                   Case[]
  caseStatusChanges       CaseStatusHistory[]
  uploadedDocuments       Document[]

  @@map("users")
}

model Session {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  tokenHash         String                @unique @map("token_hash")
  csrfTokenHash     String                @map("csrf_token_hash")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt        DateTime              @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime              @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime              @map("absolute_expires_at") @db.Timestamptz(6)
  rotatedAt         DateTime?             @map("rotated_at") @db.Timestamptz(6)
  revokedAt         DateTime?             @map("revoked_at") @db.Timestamptz(6)
  revokedReason     SessionRevokedReason? @map("revoked_reason")
  ip                String?               @db.Inet
  userAgent         String?               @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)
  requestedIp String?   @map("requested_ip") @db.Inet
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorRole     Role?    @map("actor_role")
  action        String
  entityType    String?  @map("entity_type")
  entityId      String?  @map("entity_id")
  previousValue Json?    @map("previous_value")
  newValue      Json?    @map("new_value")
  metadata      Json?
  requestId     String?  @map("request_id")
  ip            String?  @db.Inet
  userAgent     String?  @map("user_agent")
  caseId        String?  @map("case_id") @db.Uuid

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  case  Case? @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
  @@index([entityType, entityId])
  @@index([caseId, occurredAt])
  @@map("audit_logs")
}

/// Kinds of email the outbox can hold (ADR-002: email verification, password reset and the notice
/// sent once a password has been reset).
enum EmailOutboxKind {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PASSWORD_RESET_COMPLETED

  @@map("email_outbox_kind")
}

/// Outbox of emails to send (ARCHITECTURE_REPORT: outbox pattern). It stores only the intent:
/// never a token or any other secret. A token an email carries is generated when the email is
/// dispatched, and only its hash is stored, in its own table.
model EmailOutbox {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind      EmailOutboxKind
  userId    String          @map("user_id") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt    DateTime?       @map("sent_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sentAt, createdAt])
  @@map("email_outbox")
}

/// The 7 case types of PROJECT_SPEC.md s.9 step 2 (comparendo, infracción, fotodetección,
/// transporte, notificación, actuación administrativa, otro). No other type is added.
enum CaseType {
  TRAFFIC_CITATION
  INFRACTION
  PHOTO_ENFORCEMENT
  TRANSPORT
  NOTIFICATION
  ADMINISTRATIVE_PROCEEDING
  OTHER

  @@map("case_type")
}

/// The 15 initial case states of PROJECT_SPEC.md s.8. In the first Case slice only DRAFT is
/// reachable: there are no transitions yet (DATABASE_SPEC.md).
enum CaseStatus {
  DRAFT
  DOCUMENTS_PENDING
  PRELIMINARY_ANALYSIS
  PAYMENT_PENDING
  PAID
  LEGAL_REVIEW
  DOCUMENT_PREPARATION
  READY_TO_FILE
  FILED
  WAITING_RESPONSE
  RESPONSE_RECEIVED
  FOLLOW_UP
  RESOLVED
  CLOSED
  CANCELLED

  @@map("case_status")
}

/// The central, generic object of the platform (PROJECT_SPEC.md s.7). First slice: owner, type
/// and status only.
model Case {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  type      CaseType
  status    CaseStatus @default(DRAFT)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  statusHistory CaseStatusHistory[]
  auditLogs     AuditLog[]
  documents     Document[]

  @@index([userId, createdAt])
  @@map("cases")
}

/// Every status change of a case (PROJECT_SPEC.md s.8). Append-only for the application role.
model CaseStatusHistory {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId          String      @map("case_id") @db.Uuid
  fromStatus      CaseStatus? @map("from_status")
  toStatus        CaseStatus  @map("to_status")
  changedByUserId String      @map("changed_by_user_id") @db.Uuid
  changedAt       DateTime    @default(now()) @map("changed_at") @db.Timestamptz(6)

  case      Case @relation(fields: [caseId], references: [id], onDelete: Restrict)
  changedBy User @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([caseId, changedAt])
  @@map("case_status_history")
}

/// Type of an uploaded file, detected from its content (PROJECT_SPEC.md s.9 step 4).
enum DocumentFileType {
  PDF
  JPEG
  PNG

  @@map("document_file_type")
}

/// First Documents slice: every document is UPLOADED; later values arrive with the antivirus.
enum DocumentStatus {
  UPLOADED

  @@map("document_status")
}

/// First Documents slice: OCR has not started; later values arrive with the OCR (P4).
enum DocumentOcrStatus {
  NOT_STARTED

  @@map("document_ocr_status")
}

/// A document of a case (PROJECT_SPEC.md s.16). The file lives in private object storage
/// (StorageProvider); only its metadata is stored here.
model Document {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId           String            @map("case_id") @db.Uuid
  fileName         String            @map("file_name")
  fileType         DocumentFileType  @map("file_type")
  storageKey       String            @unique @map("storage_key")
  fileSize         Int               @map("file_size")
  uploadedByUserId String            @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime          @map("created_at") @db.Timestamptz(6)
  status           DocumentStatus    @default(UPLOADED)
  ocrStatus        DocumentOcrStatus @default(NOT_STARTED) @map("ocr_status")

  case       Case @relation(fields: [caseId], references: [id], onDelete: Restrict)
  uploadedBy User @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
  @@map("documents")
}
